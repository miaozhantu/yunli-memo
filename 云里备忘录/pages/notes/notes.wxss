.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 14rpx 8rpx 22rpx;
}

.head__title {
  font-size: 34rpx;
  color: var(--ink);
}

.head__sub {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

.head__btn {
  padding: 12rpx 30rpx;
  border-radius: 26rpx;
  background: var(--red);
  color: var(--on-brand);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 16rpx;
  padding: 0 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 38rpx;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink);
}

.search__clear {
  font-size: 20rpx;
  color: var(--ink-mute);
  padding-left: 16rpx;
}

.ph {
  color: var(--ink-faint);
}

.filters {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.filters__inner {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 4rpx 10rpx;
}

.chip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 22rpx;
  color: var(--ink-soft);
}

.chip.is-on {
  border-color: var(--red);
  color: var(--red);
  background: var(--chip-on-bg);
}

.chip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.note {
  display: flex;
  padding: 0;
  overflow: hidden;
}

.note__bar {
  width: 8rpx;
  flex: 0 0 8rpx;
}

.note__body {
  flex: 1;
  min-width: 0;
  padding: 26rpx 28rpx;
}

.note__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.note__title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.note__date {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 1rpx;
}

.note__excerpt {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--ink-soft);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.note__foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.note__tag {
  font-size: 20rpx;
}

.note__audio {
  font-size: 18rpx;
  color: var(--ink-faint);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty__text {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 2;
}
