/* 导航栏右侧的保存 */
.save-btn {
  font-size: 26rpx;
  color: var(--brand);
  padding: 10rpx 0 10rpx 20rpx;
  letter-spacing: 1rpx;
}

.edit {
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.title-input {
  padding: 16rpx 8rpx 10rpx;
  font-size: 40rpx;
  line-height: 1.5;
  color: var(--ink);
}

.ph {
  color: var(--ink-faint);
}

/* 标签条 + 翻译开关 */
.bar {
  display: flex;
  align-items: center;
  margin: 6rpx 0 16rpx;
}

.bar__tags {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.bar__inner {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 4rpx;
}

.chip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 20rpx;
  color: var(--ink-soft);
}

.chip.is-on {
  border-color: var(--red);
  color: var(--red);
  background: var(--chip-on-bg);
}

.chip__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.bar__tr {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

.bar__tr-label {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.bar__tr switch {
  transform: scale(0.66);
  transform-origin: right center;
}

/* 素纸：不画横线，靠行距和留白撑住呼吸感 */
.paper {
  position: relative;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 26rpx 28rpx 30rpx;
  min-height: 560rpx;
}

.paper__ta {
  width: 100%;
  min-height: 500rpx;
  font-size: 30rpx;
  line-height: 1.95;
  letter-spacing: 1rpx;
  color: var(--ink);
  background: transparent;
}

/* 翻译气泡 */
.bubble {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #e9f1f9;
  border: 1rpx solid #cfe0f0;
  border-radius: 22rpx 22rpx 22rpx 8rpx;
}

.bubble__tag {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #5b93c7;
}

.bubble__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.85;
  color: #33465a;
}

/* 录音条 */
.audio {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
}

.audio-note {
  margin: 14rpx 6rpx 0;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--ink-faint);
}

.audio__play {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: var(--moss);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.audio__info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.audio__name {
  font-size: 24rpx;
  color: var(--ink);
}

.audio__tip {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-mute);
}

.audio__del {
  font-size: 20rpx;
  color: var(--red);
  padding: 8rpx 12rpx;
}

.danger {
  margin: 48rpx auto 0;
  width: 320rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: var(--ink-mute);
  border: 1rpx dashed var(--line);
  border-radius: 24rpx;
}

/* 底部录音坞 */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(to bottom, rgba(249, 246, 240, 0), rgba(249, 246, 240, 0.94) 38%);
  z-index: 60;
}

.dock__hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.dock__text {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.dock__hint.is-rec .dock__text {
  color: var(--red);
}

.wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 30rpx;
}

.wave__bar {
  width: 6rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: var(--red);
  animation: wave 0.9s ease-in-out infinite;
}

@keyframes wave {
  0%,
  100% {
    height: 10rpx;
  }
  50% {
    height: 28rpx;
  }
}

.mic {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--red);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(192, 85, 63, 0.26);
}

.mic.is-rec {
  background: var(--brand);
}

.mic__head {
  width: 20rpx;
  height: 30rpx;
  border-radius: 10rpx;
  background: #fff;
}

.mic__arc {
  width: 34rpx;
  height: 16rpx;
  border: 4rpx solid #fff;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  margin-top: 4rpx;
}

.mic__stem {
  width: 4rpx;
  height: 8rpx;
  background: #fff;
}
