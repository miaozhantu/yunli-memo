.lead {
  padding: 12rpx 8rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.9;
  color: var(--ink-mute);
}

.sec {
  padding: 26rpx 28rpx 20rpx;
  margin-bottom: 20rpx;
}

.sec__title {
  font-size: 28rpx;
  color: var(--ink);
  padding-bottom: 12rpx;
}

.sec__item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.sec__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--ink-faint);
  margin: 16rpx 16rpx 0 4rpx;
  flex: 0 0 8rpx;
}

.sec__text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.85;
  color: var(--ink-soft);
}

.tail {
  padding: 26rpx 8rpx 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-faint);
}
