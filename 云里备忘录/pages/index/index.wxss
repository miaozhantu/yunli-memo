.greet {
  padding: 10rpx 8rpx 26rpx;
}

.greet__date {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-mute);
}

.greet__text {
  margin-top: 8rpx;
  font-size: 40rpx;
  line-height: 1.45;
  color: var(--ink);
}

/* 三大入口 */
.entries {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
}

.entry__tile {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
}

/* 沙漏旁边两颗会闪的星，配合图标里画死的星光 */
.tile__spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f2c879;
  box-shadow: 0 0 10rpx 3rpx rgba(242, 200, 121, 0.85);
  animation: twinkle 2.6s ease-in-out infinite;
}

.tile__spark--a {
  top: 14rpx;
  right: 16rpx;
}

.tile__spark--b {
  bottom: 18rpx;
  left: 14rpx;
  animation-delay: 1.3s;
}

@keyframes twinkle {
  0%,
  100% {
    opacity: 0;
    transform: scale(0.35);
  }
  45%,
  55% {
    opacity: 1;
    transform: scale(1);
  }
}

.entry__tile--amber {
  background: #f7eddc;
}

.entry__tile--moss {
  background: #edf1e8;
  transform: rotate(2.5deg);
}

.entry__tile--red {
  background: #faebe4;
  transform: rotate(-2deg);
}

.entry__icon {
  width: 72rpx;
  height: 72rpx;
}

.entry__body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.entry__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.entry__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.entry__arrow {
  font-size: 34rpx;
  color: var(--ink-faint);
  padding-left: 12rpx;
}

/* 区块标题 */
.section {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 42rpx 8rpx 16rpx;
}

.section__title {
  font-size: 28rpx;
  color: var(--ink);
}

.section__more {
  font-size: 20rpx;
  color: var(--brand);
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

/* 剪报卡片 */
.clip {
  position: relative;
  padding: 26rpx 24rpx 20rpx;
}

.clip__tape {
  position: absolute;
  left: 46rpx;
  top: -12rpx;
  width: 92rpx;
  height: 22rpx;
  background: #eddfc0;
  border-radius: 4rpx;
  transform: rotate(-3deg);
}

.clip__swiper {
  height: 300rpx;
}

.clip__slide {
  display: flex;
  align-items: flex-start;
  height: 100%;
  padding: 6rpx 4rpx 0;
}

.clip__quote {
  flex: 0 0 auto;
  margin: -18rpx 14rpx 0 0;
  font-size: 72rpx;
  line-height: 1;
  color: #e4d5b4;
}

.clip__text {
  flex: 1;
  min-width: 0;
}

.clip__tag {
  display: inline-block;
  font-size: 18rpx;
  color: var(--ink-soft);
  background: var(--card-soft);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.clip__title {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  color: var(--ink);
}

.clip__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-mute);
}

.clip__btn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: var(--red);
  color: var(--on-brand);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.clip__bar {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.clip__track {
  flex: 1;
  height: 6rpx;
  margin-right: 16rpx;
  border-radius: 3rpx;
  background: #ede4d2;
  overflow: hidden;
}

.clip__fill {
  height: 6rpx;
  border-radius: 3rpx;
  background: #c0a458;
}

.clip__idx {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.foot {
  padding: 44rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 1rpx;
}
