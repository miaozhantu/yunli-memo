.tmpl {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.days {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
}

.day {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--ink-soft);
  border-radius: 14rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.day.is-on {
  background: var(--red);
  border-color: var(--red);
  color: var(--on-brand);
}

.tip {
  margin: 22rpx 8rpx 16rpx;
  font-size: 20rpx;
  line-height: 1.9;
  color: var(--ink-mute);
}

.slots {
  padding: 8rpx 26rpx;
}

.slot {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-top: 1rpx solid var(--line-soft);
}

.slot:first-child {
  border-top: none;
}

.slot__time {
  width: 96rpx;
  flex: 0 0 96rpx;
  font-size: 20rpx;
  color: var(--ink-mute);
}

.slot__text {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
  border-radius: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.slot__text.has-text {
  color: var(--ink);
  background: var(--card-soft);
}

.slot__input {
  flex: 1;
  height: 62rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  color: var(--ink);
  background: var(--card);
  border: 1rpx solid var(--red);
  border-radius: 12rpx;
}

.slot__ph {
  color: var(--ink-faint);
}

.clear {
  margin: 30rpx auto 0;
  width: 340rpx;
  text-align: center;
  padding: 18rpx 0;
  font-size: 22rpx;
  color: var(--ink-mute);
  border: 1rpx dashed var(--line);
  border-radius: 28rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
  z-index: 120;
}

.bar__hint {
  font-size: 18rpx;
  color: var(--ink-faint);
  text-align: center;
  margin-bottom: 12rpx;
}

.bar__btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--red);
  color: var(--on-brand);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
