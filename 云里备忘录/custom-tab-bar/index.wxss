@import "../styles/theme.wxss";

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0 calc(8rpx + env(safe-area-inset-bottom));
  background: var(--card, var(--card));
  border-top: 1rpx solid var(--line, #e6ddcb);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4rpx;
}

.tabbar__item--hover {
  opacity: 0.7;
}

.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.42;
  transition: opacity 0.18s ease;
}

.tabbar__icon--on {
  opacity: 1;
}

.tabbar__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #b4a893;
  transition: color 0.18s ease;
}

.tabbar__label--on {
  color: var(--brand);
}

/* 选中时label下面压一小道墨条，像手账里用笔画的一道 */
.tabbar__ink {
  margin-top: 3rpx;
  width: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--brand);
  transition: width 0.18s ease;
}

.tabbar__ink--on {
  width: 28rpx;
}

/* 深色主题下底栏图标是线稿，压成白色；不反相，免得棕色变成青色 */
.theme-onyx .tabbar__icon,
.theme-night .tabbar__icon {
  filter: brightness(0) invert(1);
}
